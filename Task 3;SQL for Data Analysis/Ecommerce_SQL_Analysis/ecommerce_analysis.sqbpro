-- PROJECT: ECOMMERCE SQL DATA ANALYSIS

-- 1. CREATE TABLES

CREATE TABLE IF NOT EXISTS customers (
    customer_id INTEGER PRIMARY KEY,
    customer_name TEXT,
    city TEXT,
    email TEXT
);

CREATE TABLE IF NOT EXISTS products (
    product_id INTEGER PRIMARY KEY,
    product_name TEXT,
    category TEXT,
    price REAL
);

CREATE TABLE IF NOT EXISTS orders (
    order_id INTEGER PRIMARY KEY,
    customer_id INTEGER,
    order_date TEXT,
    FOREIGN KEY (customer_id) REFERENCES customers(customer_id)
);

CREATE TABLE IF NOT EXISTS order_items (
    item_id INTEGER PRIMARY KEY,
    order_id INTEGER,
    product_id INTEGER,
    quantity INTEGER,
    FOREIGN KEY (order_id) REFERENCES orders(order_id),
    FOREIGN KEY (product_id) REFERENCES products(product_id)
);
-- 2. INSERT SAMPLE DATA

INSERT OR IGNORE INTO customers VALUES
(1, 'Anu', 'Palakkad', 'anu@gmail.com'),
(2, 'Rahul', 'Kochi', 'rahul@gmail.com'),
(3, 'Meera', 'Thrissur', 'meera@gmail.com'),
(4, 'Arjun', 'Calicut', 'arjun@gmail.com'),
(5, 'Diya', 'Palakkad', 'diya@gmail.com');

INSERT OR IGNORE INTO products VALUES
(1, 'Laptop', 'Electronics', 50000),
(2, 'Mobile', 'Electronics', 20000),
(3, 'Headphones', 'Accessories', 2000),
(4, 'Shoes', 'Fashion', 3000),
(5, 'Watch', 'Accessories', 5000);

INSERT OR IGNORE INTO orders VALUES
(101, 1, '2026-11-01'),
(102, 2, '2026-11-02'),
(103, 3, '2026-11-03'),
(104, 1, '2026-11-04'),
(105, 4, '2026-11-05');

INSERT OR IGNORE INTO order_items VALUES
(1, 101, 1, 1),
(2, 101, 3, 2),
(3, 102, 2, 1),
(4, 103, 4, 2),
(5, 104, 5, 1),
(6, 105, 3, 3);

-- 3. SELECT QUERY

SELECT * FROM customers;
-- 4. WHERE CONDITION

SELECT * FROM products
WHERE price &gt; 3000;
-- 5. GROUP BY

SELECT category, COUNT(*) AS total_products
FROM products
GROUP BY category;
-- 6. INNER JOIN

SELECT o.order_id, c.customer_name, o.order_date
FROM orders o
INNER JOIN customers c
ON o.customer_id = c.customer_id;

-- 7. CUSTOMER-WISE REVENUE

SELECT c.customer_name,
SUM(p.price * oi.quantity) AS total_spending
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id
JOIN order_items oi ON o.order_id = oi.order_id
JOIN products p ON oi.product_id = p.product_id
GROUP BY c.customer_id, c.customer_name
ORDER BY total_spending DESC;

-- 8. CREATE VIEW

CREATE VIEW IF NOT EXISTS sales_analysis AS
SELECT o.order_id, c.customer_name,
p.product_name, oi.quantity,
p.price,
(p.price * oi.quantity) AS revenue
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
JOIN order_items oi ON o.order_id = oi.order_id
JOIN products p ON oi.product_id = p.product_id;




-- 8. FINAL SALES SUMMARY

SELECT
COUNT(DISTINCT order_id) AS total_orders,
SUM(revenue) AS total_revenue,
AVG(revenue) AS average_item_revenue
FROM sales_analysis;
DROP VIEW IF EXISTS sales_analysis</sql><current_tab id="0"/></tab_sql></sqlb_project>
